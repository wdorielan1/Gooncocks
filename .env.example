# Copy this file to .env and fill in the values, or export them in your
# shell before running the scripts. Never commit your real .env file.

# From your app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Printed by: python3 get_refresh_token.py exchange <code>
YAHOO_REFRESH_TOKEN=

# Optional. If you're only in one Yahoo NFL league, leave this blank -
# run_local.py will find it automatically. If you're in more than one,
# run_local.py will print each league's key so you can set this.
LEAGUE_KEY=

# Optional. Leave blank to use Yahoo's current week.
WEEK=
